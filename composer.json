{
    "name": "horde/util",
    "description": "Utility library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Util",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "developer"
        }
    ],
    "time": "2025-05-21",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "ext-dom": "*"
    },
    "require-dev": {
        "horde/imap_client": "^3",
        "horde/test": "^3",
        "pear/pear": "*"
    },
    "suggest": {
        "horde/imap_client": "^3",
        "horde/test": "^3",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-xml": "*"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "psr-4": {
            "Horde\\Util\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Util\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}